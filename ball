<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🖍️ Bắn Gạch Crayon</title>
<style>
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }
  html, body {
    margin: 0; padding: 0;
    width: 100%; height: 100%;
    overflow: hidden;
    background: #fdf6e3;
    font-family: 'Comic Sans MS', 'Chalkboard SE', cursive;
    touch-action: manipulation;
  }
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      repeating-linear-gradient(0deg, rgba(0,0,0,0.025) 0px, rgba(0,0,0,0.025) 1px, transparent 1px, transparent 26px),
      repeating-linear-gradient(90deg, rgba(0,0,0,0.025) 0px, rgba(0,0,0,0.025) 1px, transparent 1px, transparent 26px);
    pointer-events: none; z-index: 0;
  }
  #app {
    position: relative; z-index: 1;
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    padding: 8px; gap: 6px;
  }
  h1 {
    margin: 0; text-align: center;
    font-size: clamp(16px, 4.5vw, 22px);
    color: #2d3142;
    text-shadow: 2px 2px 0 #ffd166, -1px -1px 0 #ef476f;
    letter-spacing: 1px;
    transform: rotate(-1deg);
  }
  #hud {
    display: flex; justify-content: center;
    gap: 6px; flex-shrink: 0; flex-wrap: wrap;
  }
  .stat {
    background: #fff;
    border: 2.5px solid #2d3142;
    border-radius: 14px 6px 16px 8px / 8px 16px 6px 14px;
    padding: 3px 8px;
    font-size: clamp(10px, 3vw, 13px);
    color: #2d3142; font-weight: bold;
    box-shadow: 2px 3px 0 rgba(45,49,66,0.4);
    white-space: nowrap;
  }
  .stat span { color: #ef476f; }
  .stat:nth-child(2) span { color: #06d6a0; }
  .stat:nth-child(3) span { color: #118ab2; }
  .stat:nth-child(4) span { color: #8367c7; }
  #gameWrap {
    flex: 1; display: flex;
    align-items: center; justify-content: center;
    min-height: 0; padding: 4px;
  }
  #gameContainer {
    position: relative;
    border: 3px solid #2d3142;
    border-radius: 18px 6px 20px 8px / 8px 20px 6px 18px;
    background: #fffef8;
    box-shadow: 4px 5px 0 rgba(45,49,66,0.35);
    overflow: hidden;
    max-width: 100%; max-height: 100%;
    touch-action: none;
  }
  canvas {
    display: block; width: 100%; height: 100%;
    touch-action: none;
  }
  #overlay {
    position: absolute; inset: 0;
    background: rgba(253, 246, 227, 0.97);
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center; padding: 16px;
    z-index: 10;
    overflow-y: auto;
  }
  #overlay.hidden { display: none; }
  #overlay h2 {
    font-size: clamp(18px, 5.5vw, 26px);
    color: #ef476f; margin: 0 0 8px;
    text-shadow: 2px 2px 0 #ffd166;
    transform: rotate(-2deg);
  }
  #overlay p {
    font-size: clamp(12px, 3.4vw, 14px);
    color: #2d3142; margin: 4px 0;
    line-height: 1.4; max-width: 95%;
  }
  #overlay b { color: #06d6a0; }
  #overlay button {
    margin-top: 12px;
    padding: 12px 30px;
    font-size: clamp(14px, 4.2vw, 17px);
    font-weight: bold; font-family: inherit;
    color: #fff; background: #ef476f;
    border: 3px solid #2d3142;
    border-radius: 16px 6px 18px 8px / 8px 18px 6px 16px;
    box-shadow: 3px 4px 0 #2d3142;
    cursor: pointer;
    transform: rotate(-1deg);
    -webkit-appearance: none;
    appearance: none;
    touch-action: manipulation;
  }
  #overlay button:active {
    transform: translate(2px, 3px) rotate(-1deg);
    box-shadow: 1px 1px 0 #2d3142;
  }
  #overlay input {
    margin: 10px 0 0;
    padding: 10px 14px;
    font-size: clamp(14px, 4vw, 16px);
    font-family: inherit;
    border: 2.5px solid #2d3142;
    border-radius: 12px;
    background: #fff;
    text-align: center;
    width: 220px; max-width: 90%;
    color: #2d3142;
    outline: none;
  }
  #overlay input:focus {
    border-color: #ef476f;
    box-shadow: 0 0 0 3px rgba(239,71,111,0.2);
  }
  .hint {
    font-size: clamp(10px, 3vw, 12px);
    color: #118ab2; font-style: italic;
    margin-top: 6px;
  }
  .leaderboard {
    width: 100%; max-width: 280px;
    margin: 8px auto 0;
    background: #fff;
    border: 2.5px solid #2d3142;
    border-radius: 14px 6px 16px 8px / 8px 16px 6px 14px;
    padding: 8px 10px;
    text-align: left;
  }
  .leaderboard h3 {
    margin: 0 0 6px;
    font-size: clamp(13px, 3.8vw, 15px);
    color: #2d3142;
    text-align: center;
    border-bottom: 2px dashed #ffd166;
    padding-bottom: 4px;
  }
  .lb-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 3px 4px;
    font-size: clamp(11px, 3.2vw, 13px);
    color: #2d3142;
    border-radius: 6px;
  }
  .lb-row:first-child { background: #ffd166; font-weight: bold; }
  .lb-row .rank { width: 22px; }
  .lb-row .name { flex: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lb-row .score { color: #ef476f; font-weight: bold; }
  .lb-empty {
    text-align: center;
    color: #999;
    font-style: italic;
    padding: 8px;
    font-size: 12px;
  }
  #controls {
    flex-shrink: 0;
    text-align: center;
    font-size: clamp(10px, 2.8vw, 12px);
    color: #2d3142; opacity: 0.7;
    padding-bottom: env(safe-area-inset-bottom, 4px);
  }
  .btn-secondary {
    background: #118ab2 !important;
    margin-left: 8px;
  }
</style>
</head>
<body>

<div id="app">
  <h1>🖍️ BẮN GẠCH CRAYON</h1>

  <div id="hud">
    <div class="stat">⭐ <span id="score">0</span></div>
    <div class="stat">🏆 <span id="highscore">0</span></div>
    <div class="stat">❤️ <span id="lives">3</span></div>
    <div class="stat">📦 <span id="level">1</span></div>
  </div>

  <div id="gameWrap">
    <div id="gameContainer">
      <canvas id="game"></canvas>
      <div id="overlay">
        <h2>🖍️ SẴN SÀNG?</h2>
        <p>Kéo ngang để di chuyển thanh đỡ</p>
        <p>Chạm để bắn bóng phá gạch!</p>
        <p class="hint">👆 Chạm và kéo trên màn hình</p>
        <button id="startBtn" type="button">BẮT ĐẦU 🖍️</button>
      </div>
    </div>
  </div>

  <div id="controls">
    👆 Kéo ngang di chuyển • Chạm để bắn
  </div>
</div>

<script>
// ================= CẤU HÌNH =================
var COLS = 8;
var PADDLE_W_RATIO = 0.22;
var PADDLE_H_RATIO = 0.035;
var BALL_R_RATIO = 0.016;

var canvas, ctx, container, overlay;
var scoreEl, highEl, livesEl, levelEl;

var W = 400, H = 500;

// Trạng thái
var paddle, balls, bricks, particles;
var score = 0, lives = 3, level = 1;
var highScore = 0;
var playerName = 'Người chơi';
var running = false;
var paused = false;
var gameOver = false;
var ballLaunched = false;
var rafId = null;
var lastTime = 0;
var levelBanner = null; // hiệu ứng chữ khi lên level

var INK = '#2d3142';
var PAPER = '#fffef8';
var BRICK_COLORS = ['#ef476f', '#f78c6b', '#ffd166', '#06d6a0', '#118ab2', '#8367c7'];
var PADDLE_COLOR = '#118ab2';
var BALL_COLOR = '#ef476f';

// ================= CẤU HÌNH LEVEL =================
// Mỗi level: số hàng, màu đặc biệt, mẫu bố cục
var LEVELS = [
  { rows: 4, pattern: 'full',     special: 0,    ballSpeed: 3.5 },
  { rows: 5, pattern: 'full',     special: 0.05, ballSpeed: 3.7 },
  { rows: 5, pattern: 'checker',  special: 0.08, ballSpeed: 3.9 },
  { rows: 6, pattern: 'pyramid',  special: 0.1,  ballSpeed: 4.1 },
  { rows: 6, pattern: 'zigzag',   special: 0.12, ballSpeed: 4.3 },
  { rows: 6, pattern: 'diamond',  special: 0.15, ballSpeed: 4.5 },
  { rows: 7, pattern: 'checker',  special: 0.18, ballSpeed: 4.7 },
  { rows: 7, pattern: 'pyramid',  special: 0.2,  ballSpeed: 5.0 }
];

function getLevelConfig(lv) {
  if (lv <= LEVELS.length) return LEVELS[lv - 1];
  // Level vô hạn sau khi hết cấu hình
  var base = LEVELS[LEVELS.length - 1];
  return {
    rows: Math.min(8, base.rows + Math.floor((lv - LEVELS.length) / 2)),
    pattern: ['full', 'checker', 'pyramid', 'zigzag', 'diamond'][lv % 5],
    special: Math.min(0.3, base.special + (lv - LEVELS.length) * 0.03),
    ballSpeed: Math.min(7, base.ballSpeed + (lv - LEVELS.length) * 0.2)
  };
}

// ================= DOM READY =================
function ready(fn) {
  if (document.readyState !== 'loading') fn();
  else document.addEventListener('DOMContentLoaded', fn);
}

ready(function () {
  canvas = document.getElementById('game');
  ctx = canvas.getContext('2d');
  container = document.getElementById('gameContainer');
  overlay = document.getElementById('overlay');
  scoreEl = document.getElementById('score');
  highEl = document.getElementById('highscore');
  livesEl = document.getElementById('lives');
  levelEl = document.getElementById('level');

  // Load
  try {
    highScore = parseInt(localStorage.getItem('breakoutCrayonHigh')) || 0;
    playerName = localStorage.getItem('breakoutCrayonName') || 'Người chơi';
  } catch (e) {}
  highEl.textContent = highScore;

  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  window.addEventListener('orientationchange', function () {
    setTimeout(resizeCanvas, 250);
  });

  bindTap(document.getElementById('startBtn'), askNameThenStart);
  bindPaddleControl();
  document.addEventListener('keydown', onKeyDown);

  resetState();
  drawInitialScreen();
});

// ================= BẢNG XẾP HẠNG =================
function getLeaderboard() {
  try {
    var raw = localStorage.getItem('breakoutCrayonLeaderboard');
    return raw ? JSON.parse(raw) : [];
  } catch (e) { return []; }
}

function saveLeaderboard(list) {
  try {
    localStorage.setItem('breakoutCrayonLeaderboard', JSON.stringify(list));
  } catch (e) {}
}

function addToLeaderboard(name, sc) {
  var list = getLeaderboard();
  list.push({ name: name, score: sc, date: Date.now() });
  list.sort(function (a, b) { return b.score - a.score; });
  list = list.slice(0, 5); // top 5
  saveLeaderboard(list);
  return list;
}

function renderLeaderboardHTML() {
  var list = getLeaderboard();
  var html = '<div class="leaderboard">';
  html += '<h3>🏆 BẢNG XẾP HẠNG</h3>';
  if (list.length === 0) {
    html += '<div class="lb-empty">Chưa có ai! Hãy là người đầu tiên 🎉</div>';
  } else {
    for (var i = 0; i < list.length; i++) {
      var medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1) + '.';
      html += '<div class="lb-row">';
      html += '<span class="rank">' + medal + '</span>';
      html += '<span class="name">' + escapeHtml(list[i].name) + '</span>';
      html += '<span class="score">' + list[i].score + '</span>';
      html += '</div>';
    }
  }
  html += '</div>';
  return html;
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

// ================= TAP CHUẨN =================
function bindTap(el, fn) {
  if (!el) return;
  var fired = false;
  function fire(e) {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    if (fired) return;
    fired = true;
    setTimeout(function () { fired = false; }, 300);
    fn();
  }
  el.addEventListener('touchend', fire, { passive: false });
  el.addEventListener('click', fire);
}

// ================= RESIZE =================
function resizeCanvas() {
  var wrap = document.getElementById('gameWrap');
  var availW = wrap.clientWidth;
  var availH = wrap.clientHeight;
  var ratio = 4 / 5;
  var w, h;
  if (availW / availH > ratio) {
    h = availH; w = h * ratio;
  } else {
    w = availW; h = w / ratio;
  }
  w = Math.max(150, Math.floor(w));
  h = Math.max(180, Math.floor(h));

  var dpr = window.devicePixelRatio || 1;
  container.style.width = w + 'px';
  container.style.height = h + 'px';
  canvas.width = Math.round(w * dpr);
  canvas.height = Math.round(h * dpr);
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  W = w; H = h;

  if (paddle) {
    paddle.w = W * PADDLE_W_RATIO;
    paddle.h = Math.max(8, H * PADDLE_H_RATIO);
    paddle.y = H - paddle.h - 10;
    paddle.x = Math.min(Math.max(0, paddle.x), W - paddle.w);
  }
  if (balls && !ballLaunched && paddle) {
    for (var i = 0; i < balls.length; i++) {
      balls[i].x = paddle.x + paddle.w / 2;
      balls[i].y = paddle.y - balls[i].r - 1;
    }
  }
  if (bricks) layoutBricks();
  if (running) draw();
}

// ================= STATE =================
function resetState() {
  score = 0;
  lives = 3;
  level = 1;
  gameOver = false;
  paused = false;
  ballLaunched = false;
  levelBanner = null;
  scoreEl.textContent = '0';
  livesEl.textContent = '3';
  levelEl.textContent = '1';

  paddle = {
    w: W * PADDLE_W_RATIO,
    h: Math.max(8, H * PADDLE_H_RATIO),
    x: (W - W * PADDLE_W_RATIO) / 2,
    y: H - Math.max(8, H * PADDLE_H_RATIO) - 10,
    speed: 6
  };

  var ballR = Math.max(4, W * BALL_R_RATIO);
  balls = [{
    x: paddle.x + paddle.w / 2,
    y: paddle.y - ballR - 1,
    r: ballR, vx: 0, vy: 0,
    speed: 3.5
  }];

  particles = [];
  buildBricks();
}

// ================= GẠCH THEO PATTERN =================
function buildBricks() {
  bricks = [];
  var cfg = getLevelConfig(level);
  var padX = W * 0.02;
  var startY = H * 0.08;
  var brickW = (W - padX * 2 - (COLS - 1) * 3) / COLS;
  var brickH = H * 0.045;
  var rows = cfg.rows;

  for (var r = 0; r < rows; r++) {
    for (var c = 0; c < COLS; c++) {
      var include = true;
      switch (cfg.pattern) {
        case 'checker':
          include = (r + c) % 2 === 0;
          break;
        case 'pyramid':
          include = c >= Math.floor((COLS - rows + r) / 2) &&
                    c < COLS - Math.floor((COLS - rows + r) / 2);
          if (r > 0) {
            var pad = Math.floor(r * (COLS / 2) / rows);
            include = c >= pad && c < COLS - pad;
          }
          break;
        case 'zigzag':
          include = true;
          break;
        case 'diamond':
          var mid = Math.floor(COLS / 2);
          var dist = Math.abs(c - mid);
          var maxDist = Math.floor(rows / 2);
          include = dist <= maxDist && (r >= dist) && (r <= rows - 1 - Math.max(0, dist - maxDist + 1));
          include = dist + Math.abs(r - Math.floor(rows / 2)) <= Math.floor((rows + COLS) / 4);
          break;
        case 'full':
        default:
          include = true;
      }
      if (!include) continue;

      var isSpecial = Math.random() < cfg.special;
      bricks.push({
        x: padX + c * (brickW + 3),
        y: startY + r * (brickH + 3),
        w: brickW, h: brickH,
        color: BRICK_COLORS[r % BRICK_COLORS.length],
        alive: true,
        special: isSpecial,
        hits: isSpecial ? 2 : 1,
        maxHits: isSpecial ? 2 : 1,
        points: (rows - r) * 5 + 5
      });
    }
  }
}

function layoutBricks() {
  if (!bricks) return;
  var padX = W * 0.02;
  var startY = H * 0.08;
  var brickW = (W - padX * 2 - (COLS - 1) * 3) / COLS;
  var brickH = H * 0.045;
  var cfg = getLevelConfig(level);
  var rows = cfg.rows;
  var idx = 0;
  // layoutBricks chỉ cập nhật các gạch đang tồn tại, không tạo lại
  for (var r = 0; r < rows; r++) {
    for (var c = 0; c < COLS; c++) {
      if (idx < bricks.length) {
        bricks[idx].x = padX + c * (brickW + 3);
        bricks[idx].y = startY + r * (brickH + 3);
        bricks[idx].w = brickW;
        bricks[idx].h = brickH;
        idx++;
      }
    }
  }
}

// ================= VẼ =================
function drawInitialScreen() {
  if (!ctx) return;
  var w = canvas.clientWidth || 200;
  var h = canvas.clientHeight || 250;
  ctx.fillStyle = PAPER;
  ctx.fillRect(0, 0, w, h);
  ctx.fillStyle = 'rgba(45,49,66,0.1)';
  for (var y = 0; y < h; y += 26) {
    for (var x = 0; x < w; x += 26) {
      ctx.beginPath();
      ctx.arc(x, y, 0.9, 0, Math.PI * 2);
      ctx.fill();
    }
  }
}

function crayonRectFill(x, y, w, h, color, strokeW) {
  if (strokeW == null) strokeW = 2;
  ctx.fillStyle = color;
  var r = Math.min(w, h) * 0.25;
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = INK;
  ctx.lineWidth = strokeW;
  ctx.stroke();
}

function draw() {
  if (!ctx) return;
  var w = W, h = H;

  ctx.fillStyle = PAPER;
  ctx.fillRect(0, 0, w, h);

  ctx.fillStyle = 'rgba(45,49,66,0.08)';
  for (var y = 0; y < h; y += 26) {
    for (var x = 0; x < w; x += 26) {
      ctx.beginPath();
      ctx.arc(x, y, 0.9, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Gạch
  if (bricks) {
    for (var i = 0; i < bricks.length; i++) {
      var b = bricks[i];
      if (!b.alive) continue;
      var col = b.color;
      if (b.special && b.hits < b.maxHits) {
        // gạch đặc biệt đã bị đập 1 lần → mờ
        col = shadeColor(b.color, -0.3);
      }
      crayonRectFill(b.x, b.y, b.w, b.h, col, 1.8);

      // highlight
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.beginPath();
      ctx.ellipse(b.x + b.w * 0.3, b.y + b.h * 0.3, b.w * 0.15, b.h * 0.15, 0, 0, Math.PI * 2);
      ctx.fill();

      // đánh dấu gạch đặc biệt (2 hit)
      if (b.special) {
        ctx.fillStyle = INK;
        ctx.font = 'bold ' + Math.max(9, b.h * 0.55) + 'px Comic Sans MS, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('★', b.x + b.w / 2, b.y + b.h / 2);
      }
    }
  }

  // Paddle
  if (paddle) {
    crayonRectFill(paddle.x, paddle.y, paddle.w, paddle.h, PADDLE_COLOR, 2.2);
    ctx.strokeStyle = 'rgba(255,255,255,0.5)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(paddle.x + 6, paddle.y + paddle.h / 2);
    ctx.lineTo(paddle.x + paddle.w - 6, paddle.y + paddle.h / 2);
    ctx.stroke();
  }

  // Bóng
  if (balls) {
    for (var j = 0; j < balls.length; j++) {
      var ball = balls[j];
      ctx.fillStyle = 'rgba(239,71,111,0.2)';
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.r * 2, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = BALL_COLOR;
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = INK;
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.7)';
      ctx.beginPath();
      ctx.arc(ball.x - ball.r * 0.35, ball.y - ball.r * 0.35, ball.r * 0.3, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Hạt
  if (particles) {
    for (var p = 0; p < particles.length; p++) {
      var pt = particles[p];
      ctx.globalAlpha = pt.life / pt.maxLife;
      ctx.fillStyle = pt.color;
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, pt.size, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  // Banner lên level
  if (levelBanner) {
    var elapsed = Date.now() - levelBanner.start;
    var dur = 1500;
    if (elapsed < dur) {
      var alpha = elapsed < 400 ? elapsed / 400 : (elapsed > dur - 400 ? (dur - elapsed) / 400 : 1);
      ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
      ctx.fillStyle = 'rgba(253,246,227,0.85)';
      ctx.fillRect(0, h * 0.35, w, h * 0.2);
      ctx.fillStyle = '#ef476f';
      ctx.font = 'bold ' + Math.max(18, W * 0.06) + 'px Comic Sans MS, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('📦 LEVEL ' + levelBanner.level, w / 2, h * 0.45);
      ctx.globalAlpha = 1;
    } else {
      levelBanner = null;
    }
  }

  // Gợi ý chạm để bắn
  if (running && !ballLaunched && !gameOver) {
    var pulse2 = 0.6 + Math.sin(Date.now() / 300) * 0.4;
    ctx.globalAlpha = pulse2;
    ctx.fillStyle = INK;
    ctx.font = 'bold ' + Math.max(11, W * 0.035) + 'px Comic Sans MS, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('👆 Chạm để bắn!', w / 2, h * 0.65);
    ctx.globalAlpha = 1;
  }
}

function shadeColor(hex, amt) {
  var c = hex.replace('#', '');
  var num = parseInt(c, 16);
  var r = (num >> 16) & 255, g = (num >> 8) & 255, b = num & 255;
  r = Math.max(0, Math.min(255, r + amt * 255));
  g = Math.max(0, Math.min(255, g + amt * 255));
  b = Math.max(0, Math.min(255, b + amt * 255));
  return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
}

// ================= LOGIC =================
function step() {
  for (var i = balls.length - 1; i >= 0; i--) {
    var ball = balls[i];

    if (!ballLaunched) {
      ball.x = paddle.x + paddle.w / 2;
      ball.y = paddle.y - ball.r - 1;
      continue;
    }

    ball.x += ball.vx;
    ball.y += ball.vy;

    if (ball.x - ball.r < 0) {
      ball.x = ball.r;
      ball.vx = Math.abs(ball.vx);
      spawnHitParticles(ball.x, ball.y, '#118ab2');
    }
    if (ball.x + ball.r > W) {
      ball.x = W - ball.r;
      ball.vx = -Math.abs(ball.vx);
      spawnHitParticles(ball.x, ball.y, '#118ab2');
    }
    if (ball.y - ball.r < 0) {
      ball.y = ball.r;
      ball.vy = Math.abs(ball.vy);
      spawnHitParticles(ball.x, ball.y, '#118ab2');
    }

    // Va chạm paddle
    if (ball.y + ball.r >= paddle.y &&
        ball.y - ball.r <= paddle.y + paddle.h &&
        ball.x >= paddle.x - ball.r &&
        ball.x <= paddle.x + paddle.w + ball.r &&
        ball.vy > 0) {

      var rel = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
      rel = Math.max(-1, Math.min(1, rel));
      var angle = rel * Math.PI * 0.42;
      var sp = Math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy);
      ball.vx = sp * Math.sin(angle);
      ball.vy = -sp * Math.cos(angle);
      ball.y = paddle.y - ball.r - 0.5;
      spawnHitParticles(ball.x, ball.y, '#06d6a0');
    }

    // Va chạm gạch
    if (bricks) {
      for (var b = 0; b < bricks.length; b++) {
        var brick = bricks[b];
        if (!brick.alive) continue;

        if (ball.x + ball.r > brick.x &&
            ball.x - ball.r < brick.x + brick.w &&
            ball.y + ball.r > brick.y &&
            ball.y - ball.r < brick.y + brick.h) {

          var dx = ball.x - Math.max(brick.x, Math.min(ball.x, brick.x + brick.w));
          var dy = ball.y - Math.max(brick.y, Math.min(ball.y, brick.y + brick.h));

          if (Math.abs(dx) > Math.abs(dy)) {
            ball.vx = -ball.vx;
            ball.x += ball.vx > 0 ? 1 : -1;
          } else {
            ball.vy = -ball.vy;
            ball.y += ball.vy > 0 ? 1 : -1;
          }

          brick.hits--;
          if (brick.hits <= 0) {
            brick.alive = false;
            score += brick.points;
            scoreEl.textContent = score;
            spawnBrickParticles(brick);
          } else {
            spawnHitParticles(ball.x, ball.y, brick.color);
          }
          break;
        }
      }
    }

    if (ball.y - ball.r > H) {
      balls.splice(i, 1);
    }
  }

  // Hết bóng → mất mạng
  if (balls.length === 0) {
    lives--;
    livesEl.textContent = lives;
    if (lives <= 0) {
      endGame();
      return;
    }
    ballLaunched = false;
    var ballR = Math.max(4, W * BALL_R_RATIO);
    var cfg = getLevelConfig(level);
    balls = [{
      x: paddle.x + paddle.w / 2,
      y: paddle.y - ballR - 1,
      r: ballR, vx: 0, vy: 0,
      speed: cfg.ballSpeed
    }];
    return;
  }

  // Thắng màn
  if (bricks) {
    var anyAlive = false;
    for (var k = 0; k < bricks.length; k++) {
      if (bricks[k].alive) { anyAlive = true; break; }
    }
    if (!anyAlive) {
      nextLevel();
    }
  }
}

function nextLevel() {
  level++;
  levelEl.textContent = level;
  levelBanner = { level: level, start: Date.now() };

  ballLaunched = false;
  var cfg = getLevelConfig(level);
  var ballR = Math.max(4, W * BALL_R_RATIO);
  balls = [{
    x: paddle.x + paddle.w / 2,
    y: paddle.y - ballR - 1,
    r: ballR, vx: 0, vy: 0,
    speed: cfg.ballSpeed
  }];

  buildBricks();
}

// ================= PARTICLES =================
function spawnHitParticles(x, y, color) {
  for (var i = 0; i < 4; i++) {
    var angle = Math.random() * Math.PI * 2;
    particles.push({
      x: x, y: y,
      vx: Math.cos(angle) * 2,
      vy: Math.sin(angle) * 2,
      size: 1.5 + Math.random() * 2,
      life: 15, maxLife: 15,
      color: color
    });
  }
}

function spawnBrickParticles(brick) {
  for (var i = 0; i < 8; i++) {
    var angle = Math.random() * Math.PI * 2;
    var sp = 1 + Math.random() * 3;
    particles.push({
      x: brick.x + brick.w / 2,
      y: brick.y + brick.h / 2,
      vx: Math.cos(angle) * sp,
      vy: Math.sin(angle) * sp,
      size: 1.5 + Math.random() * 3,
      life: 22, maxLife: 22,
      color: brick.color
    });
  }
}

function updateParticles() {
  for (var i = particles.length - 1; i >= 0; i--) {
    var p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.1;
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

// ================= LOOP =================
function loop(ts) {
  if (!running) return;
  rafId = requestAnimationFrame(loop);
  var dt = ts - lastTime;
  if (dt > 100) dt = 100;
  lastTime = ts;

  if (!paused && !gameOver) {
    var steps = Math.min(3, Math.max(1, Math.round(dt / 16.67)));
    for (var s = 0; s < steps; s++) {
      step();
      if (gameOver) break;
    }
    updateParticles();
  }
  draw();
}

// ================= START/END =================
function askNameThenStart() {
  // Hiển thị form nhập tên + bảng xếp hạng
  var lbHTML = renderLeaderboardHTML();
  overlay.innerHTML =
    '<h2>🖍️ NHẬP TÊN</h2>' +
    '<p>Tên của bạn sẽ lưu vào bảng xếp hạng</p>' +
    '<input id="nameInput" type="text" maxlength="16" placeholder="Nhập tên..." value="' + escapeHtml(playerName) + '">' +
    '<button id="goBtn" type="button">VÀO GAME 🖍️</button>' +
    lbHTML;
  overlay.classList.remove('hidden');

  var input = document.getElementById('nameInput');
  var goBtn = document.getElementById('goBtn');

  var doStart = function () {
    var name = input.value.trim();
    if (!name) name = 'Ẩn danh';
    if (name.length > 16) name = name.slice(0, 16);
    playerName = name;
    try { localStorage.setItem('breakoutCrayonName', name); } catch (e) {}
    startGame();
  };

  bindTap(goBtn, doStart);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); doStart(); }
  });
}

function startGame() {
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  resetState();
  resizeCanvas();
  overlay.classList.add('hidden');
  running = true;
  lastTime = performance.now();
  rafId = requestAnimationFrame(loop);
}

function endGame() {
  gameOver = true;
  running = false;
  if (rafId) { cancelAnimationFrame(rafId); rafId = null; }

  if (score > highScore) {
    highScore = score;
    try { localStorage.setItem('breakoutCrayonHigh', highScore); } catch (e) {}
    highEl.textContent = highScore;
  }

  // Lưu vào bảng xếp hạng
  addToLeaderboard(playerName, score);

  draw();

  var lbHTML = renderLeaderboardHTML();
  var isNewRecord = score === highScore && score > 0;

  showOverlay(
    isNewRecord ? '🎉 KỶ LỤC MỚI!' : '💀 THUA RỒI!',
    'Người chơi: <b>' + escapeHtml(playerName) + '</b><br>' +
    'Điểm: <b>' + score + '</b> • Level: ' + level + '<br>' +
    'Kỷ lục: ' + highScore,
    'CHƠI LẠI 🖍️',
    lbHTML
  );
}

function showOverlay(title, html, btnText, extraHTML) {
  overlay.innerHTML =
    '<h2>' + title + '</h2>' +
    '<p>' + html + '</p>' +
    (extraHTML || '') +
    '<button id="overlayBtn" type="button">' + btnText + '</button>' +
    '<button id="changeNameBtn" class="btn-secondary" type="button">Đổi tên</button>';
  overlay.classList.remove('hidden');

  bindTap(document.getElementById('overlayBtn'), function () {
    // Nếu đã có tên → chơi lại luôn
    startGame();
  });
  bindTap(document.getElementById('changeNameBtn'), askNameThenStart);
}

// ================= ĐIỀU KHIỂN =================
function launchBall() {
  if (!running || paused || gameOver || ballLaunched) return;
  if (!balls || balls.length === 0) return;
  ballLaunched = true;
  for (var i = 0; i < balls.length; i++) {
    var angle = -Math.PI / 2 + (Math.random() - 0.5) * 0.6;
    balls[i].vx = Math.cos(angle) * balls[i].speed;
    balls[i].vy = Math.sin(angle) * balls[i].speed;
  }
}

function bindPaddleControl() {
  var activeTouchId = null;

  function movePaddleTo(clientX) {
    if (!paddle) return;
    var rect = canvas.getBoundingClientRect();
    var scaleX = W / rect.width;
    var x = (clientX - rect.left) * scaleX;
    var newX = x - paddle.w / 2;
    paddle.x = Math.max(0, Math.min(W - paddle.w, newX));
    if (!ballLaunched && balls && balls.length > 0) {
      balls[0].x = paddle.x + paddle.w / 2;
      balls[0].y = paddle.y - balls[0].r - 1;
    }
  }

  container.addEventListener('touchstart', function (e) {
    if (!running || paused || gameOver) return;
    e.preventDefault();
    if (activeTouchId === null && e.touches.length > 0) {
      activeTouchId = e.touches[0].identifier;
      movePaddleTo(e.touches[0].clientX);
    }
    if (!ballLaunched) launchBall();
  }, { passive: false });

  container.addEventListener('touchmove', function (e) {
    if (!running || paused || gameOver) return;
    e.preventDefault();
    for (var i = 0; i < e.touches.length; i++) {
      if (e.touches[i].identifier === activeTouchId) {
        movePaddleTo(e.touches[i].clientX);
        break;
      }
    }
  }, { passive: false });

  container.addEventListener('touchend', function (e) {
    if (activeTouchId !== null) {
      for (var i = 0; i < e.changedTouches.length; i++) {
        if (e.changedTouches[i].identifier === activeTouchId) {
          activeTouchId = null;
          break;
        }
      }
    }
    if (e.touches.length === 0) activeTouchId = null;
  }, { passive: true });

  container.addEventListener('mousemove', function (e) {
    if (!running || paused || gameOver) return;
    movePaddleTo(e.clientX);
  });
  container.addEventListener('mousedown', function () {
    if (!running || paused || gameOver) return;
    launchBall();
  });
  container.addEventListener('click', function () {
    if (!running || paused || gameOver) return;
    launchBall();
  });
}

function onKeyDown(e) {
  var k = e.key.toLowerCase();
  if (k === ' ' || k === 'spacebar') {
    e.preventDefault();
    if (!running) return;
    if (!ballLaunched) launchBall();
    else {
      paused = !paused;
      if (paused) {
        showOverlay('⏸️ TẠM DỪNG', 'Nhấn Space để tiếp tục', 'TIẾP TỤC ▶', '');
        // Ghi đè nút chơi lại → tiếp tục
        var btn = document.getElementById('overlayBtn');
        var clone = btn.cloneNode(true);
        btn.parentNode.replaceChild(clone, btn);
        bindTap(clone, function () {
          paused = false;
          overlay.classList.add('hidden');
        });
      } else {
        overlay.classList.add('hidden');
      }
    }
    return;
  }
  if (!running || paused || gameOver || !paddle) return;
  if (k === 'arrowleft' || k === 'a') {
    paddle.x = Math.max(0, paddle.x - 20);
    if (!ballLaunched && balls[0]) balls[0].x = paddle.x + paddle.w / 2;
  }
  if (k === 'arrowright' || k === 'd') {
    paddle.x = Math.min(W - paddle.w, paddle.x + 20);
    if (!ballLaunched && balls[0]) balls[0].x = paddle.x + paddle.w / 2;
  }
}

document.addEventListener('gesturestart', function (e) { e.preventDefault(); });
document.addEventListener('dblclick', function (e) { e.preventDefault(); }, { passive: false });
</script>
